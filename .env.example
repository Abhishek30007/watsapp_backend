# CelebrateMate — Environment Variables
# Copy this file to .env and fill in your values

PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/celebratemate

# Google Gemini AI — get free at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Twilio WhatsApp Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here
# Twilio WhatsApp sender (e.g. +14155238886 for Sandbox)
TWILIO_WHATSAPP_NUMBER=your_twilio_whatsapp_number_here

# Redis Configuration (Required for BullMQ Asynchronous Queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Wappfly WhatsApp Gateway Configuration (Alternative / Fallback)
WAPPFLY_API_TOKEN=your_wappfly_api_token_here


