# CelebrateMate — Environment Variables
# Copy this file to .env and fill in your values

PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/celebratemate

# TextBee SMS Gateway — get from https://textbee.dev/dashboard
TEXTBEE_API_KEY=your_textbee_api_key_here
TEXTBEE_DEVICE_ID=your_textbee_device_id_here

# Gmail — use an App Password, NOT your login password
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS="your gmail app password here"

# Google Gemini AI — get free at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Wappfly WhatsApp Gateway Configuration
WAPPFLY_API_TOKEN=your_wappfly_api_token_here
